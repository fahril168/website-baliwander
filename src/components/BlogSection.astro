---
import { blogPosts } from '../data/tours';
import { ArrowRight } from '@lucide/astro';
---

<section id="blog" class="py-24 bg-slate-50/70 border-t border-slate-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header dengan Link "Lihat Semua Artikel" di Kanan Atas -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          Panduan & Tips Wisata Bali
        </h2>
        <p class="text-base sm:text-lg text-slate-600 mt-2 max-w-xl">
          Catatan lapangan dan tips praktis langsung dari supir serta pemandu lokal kami agar liburanmu berjalan lancar.
        </p>
      </div>

      <a 
        href="#blog" 
        class="group inline-flex items-center gap-1.5 text-base sm:text-lg font-bold text-sky-600 hover:text-sky-700 transition-colors whitespace-nowrap self-start sm:self-auto py-1"
      >
        <span>Lihat Semua Artikel</span>
        <ArrowRight class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <!-- Blog Grid: 3 Kolom Bersih & Konsisten -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {blogPosts.map((post) => (
        <article class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group hover:-translate-y-1.5">
          
          <!-- Image Cover (Lebih Tinggi & Bersih, Tanpa Floating Badge) -->
          <div class="relative h-60 overflow-hidden bg-slate-100">
            <img 
              src={post.image} 
              alt={post.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
          </div>

          <!-- Body Content -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <!-- Kategori & Tanggal Rilis di Bawah Gambar -->
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-3">
                <span class="text-sky-600 font-bold">{post.category}</span>
                <span>•</span>
                <span>{post.date}</span>
              </div>

              <!-- Judul Artikel -->
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors leading-snug line-clamp-2">
                {post.title}
              </h3>

              <!-- Ringkasan / Summary -->
              <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed line-clamp-3">
                {post.summary}
              </p>
            </div>

            <!-- Link Baca Selengkapnya -->
            <div class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-end">
              <a 
                href={`https://wa.me/6281234567890?text=Halo%20BaliWander%2C%20saya%20membaca%20artikel%20${encodeURIComponent(post.title)}%20dan%20mau%20konsultasi`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-600 group-hover:text-sky-700 transition-colors"
              >
                <span>Baca Panduan</span>
                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
