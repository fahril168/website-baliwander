---
import { Check } from '@lucide/astro';
import { uspPointsData } from '../data/tours';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
const points = uspPointsData[lang];
---

<section id="usp-1" class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Sisi Kiri: Narasi Nilai & Poin Keunggulan (lg:col-span-6) -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
            {t('usp.title')}
          </h2>
          <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-xl">
            {t('usp.subtitle')}
          </p>
        </div>

        <!-- 3 Poin Keunggulan Bersih & Humanis -->
        <div class="space-y-6 pt-2">
          {points.map((pt) => (
            <div class="flex items-start gap-4 group">
              <div class="w-10 h-10 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0 mt-1 transition-colors group-hover:bg-sky-500 group-hover:text-white">
                <Check class="w-5 h-5 stroke-[2.5]" />
              </div>
              <div class="space-y-1">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">
                  {pt.title}
                </h3>
                <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-lg">
                  {pt.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Sisi Kanan: 2 Foto Berukuran Lebih Besar -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-12 gap-4 sm:gap-6 items-center">
          
          <!-- Foto 1: Suasana Tebing dan Pantai Kelingking Nusa Penida -->
          <div class="col-span-7 rounded-3xl sm:rounded-4xl overflow-hidden shadow-2xl border border-slate-100 h-[420px] sm:h-[480px] bg-slate-100">
            <img 
              src="https://images.unsplash.com/photo-1518548419970-58e3b4079ab2?auto=format&fit=crop&w=1000&q=80" 
              alt="Bali Scenic Cliffs and Beaches" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" 
            />
          </div>

          <!-- Foto 2: Pura Uluwatu Sunset -->
          <div class="col-span-5 rounded-3xl sm:rounded-4xl overflow-hidden shadow-2xl border border-slate-100 h-[360px] sm:h-[420px] bg-slate-100 translate-y-6 sm:translate-y-8">
            <img 
              src="https://images.unsplash.com/photo-1555400038-63f5ba517a47?auto=format&fit=crop&w=800&q=80" 
              alt="Bali Heritage Sunset" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" 
            />
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
