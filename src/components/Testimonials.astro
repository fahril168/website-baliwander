---
import { Quote } from '@lucide/astro';
import { testimonialsData } from '../data/tours';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
const testimonials = testimonialsData[lang];
---

<section id="testimoni" class="relative py-28 overflow-hidden">
  <!-- Background Image Pemandangan Alam Bali Ikonik -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=2000&q=85" 
      alt="Bali Scenic Nature" 
      class="w-full h-full object-cover object-center" 
    />
    <!-- Scrim Gelap Bersih -->
    <div class="absolute inset-0 bg-slate-950/70"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {t('testimonials.title')}
      </h2>
      <p class="text-base sm:text-lg text-slate-200 mt-3 leading-relaxed">
        {t('testimonials.subtitle')}
      </p>
    </div>

    <!-- 3 Kolom Kartu Testimoni -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-8 border border-white/40 shadow-2xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5 hover:bg-white">
          
          <div class="space-y-4">
            <Quote class="w-8 h-8 text-sky-500 opacity-80" />
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
              "{item.text}"
            </p>
          </div>

          <!-- Profil Pengulas -->
          <div class="mt-8 pt-6 border-t border-slate-100 flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-full bg-sky-50 text-sky-700 font-bold text-sm flex items-center justify-center shrink-0 border border-sky-100">
              {item.initials}
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-900 leading-tight">
                {item.name}
              </h3>
              <p class="text-xs text-slate-500 font-medium mt-0.5">
                {item.origin}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
