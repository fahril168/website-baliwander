---
import { ChevronDown } from '@lucide/astro';
import { faqData } from '../data/tours';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
const faqs = faqData[lang];
---

<section id="faq" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        {t('faq.title')}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed">
        {t('faq.subtitle')}
      </p>
    </div>

    <!-- Accordion Garis Minimalis -->
    <div class="divide-y divide-slate-200/80 border-y border-slate-200/80">
      {faqs.map((f, i) => (
        <div class="faq-item py-6">
          <button 
            type="button"
            class="faq-btn w-full flex items-center justify-between text-left font-bold text-lg sm:text-xl text-slate-900 hover:text-sky-600 transition-colors gap-6 cursor-pointer select-none group"
            aria-expanded="false"
          >
            <span>{f.q}</span>
            <div class="faq-icon-wrapper w-8 h-8 rounded-full flex items-center justify-center text-slate-400 group-hover:text-sky-600 shrink-0 transition-transform duration-300">
              <ChevronDown class="w-5 h-5 transition-transform duration-300" />
            </div>
          </button>
          
          <!-- Answer Collapse Container -->
          <div class="faq-collapse overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out">
            <p class="pt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl pr-6 font-normal">
              {f.a}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const btn = item.querySelector('.faq-btn') as HTMLButtonElement;
    const collapse = item.querySelector('.faq-collapse') as HTMLElement;
    const icon = item.querySelector('.faq-icon-wrapper svg') as SVGElement;

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      faqItems.forEach((otherItem) => {
        if (otherItem !== item) {
          const otherBtn = otherItem.querySelector('.faq-btn') as HTMLButtonElement;
          const otherCollapse = otherItem.querySelector('.faq-collapse') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon-wrapper svg') as SVGElement;

          otherBtn?.setAttribute('aria-expanded', 'false');
          if (otherCollapse) {
            otherCollapse.style.maxHeight = '0px';
            otherCollapse.classList.remove('opacity-100');
            otherCollapse.classList.add('opacity-0');
          }
          otherIcon?.classList.remove('rotate-180');
        }
      });

      if (!isExpanded) {
        btn.setAttribute('aria-expanded', 'true');
        collapse.style.maxHeight = collapse.scrollHeight + 'px';
        collapse.classList.remove('opacity-0');
        collapse.classList.add('opacity-100');
        icon?.classList.add('rotate-180');
      } else {
        btn.setAttribute('aria-expanded', 'false');
        collapse.style.maxHeight = '0px';
        collapse.classList.remove('opacity-100');
        collapse.classList.add('opacity-0');
        icon?.classList.remove('rotate-180');
      }
    });
  });
</script>
