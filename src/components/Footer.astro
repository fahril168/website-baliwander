---
import { Phone, Mail, MapPin, MessageSquare, Camera, Video } from '@lucide/astro';
---

<footer class="bg-white border-t border-slate-200/80 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 3 Kolom Bersih, Lega & Terstruktur -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-14 mb-14">
      
      <!-- Kolom 1 (Kiri - Lebar): Brand & Tentang Kami (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Logo Identik dengan Navbar -->
        <a href="#" class="inline-flex items-center gap-1.5 group">
          <span class="text-2xl font-black tracking-tight text-slate-900">
            BaliWander<span class="text-sky-500 font-black">.</span>
          </span>
          <span class="text-xs font-semibold text-slate-400 pl-2 border-l border-slate-200">
            Tour & Travel
          </span>
        </a>

        <p class="text-sm text-slate-600 leading-relaxed max-w-md font-normal">
          Penyedia paket liburan private, open trip, dan sewa transportasi berizin resmi di Bali & sekitarnya. Kami mengutamakan kenyamanan, transparansi rute, dan keselamatan perjalanan.
        </p>

        <!-- Ikon Sosial Media Nyata -->
        <div class="pt-2 flex items-center gap-2.5 text-slate-500">
          <a 
            href="https://wa.me/6281234567890" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="WhatsApp"
          >
            <MessageSquare class="w-4 h-4" />
          </a>
          <a 
            href="#" 
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="Instagram Galeri Trip"
          >
            <Camera class="w-4 h-4" />
          </a>
          <a 
            href="#" 
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="TikTok Video Dokumentasi"
          >
            <Video class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Kolom 2 (Tengah): Navigasi Utama Halaman (lg:col-span-3) -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4">Navigasi</h3>
        <ul class="space-y-3 text-sm text-slate-600">
          <li><a href="#" class="hover:text-sky-600 transition-colors">Beranda</a></li>
          <li><a href="#popular-packages" class="hover:text-sky-600 transition-colors">Paket Wisata Populer</a></li>
          <li><a href="#usp-1" class="hover:text-sky-600 transition-colors">Mengapa Memilih Kami</a></li>
          <li><a href="#trips" class="hover:text-sky-600 transition-colors">Paket Liburan Lengkap</a></li>
          <li><a href="#destinations" class="hover:text-sky-600 transition-colors">Destinasi Favorit</a></li>
          <li><a href="#faq" class="hover:text-sky-600 transition-colors">Tanya Jawab (FAQ)</a></li>
        </ul>
      </div>

      <!-- Kolom 3 (Kanan): Kontak & Kantor Resmi (lg:col-span-4) -->
      <div class="lg:col-span-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4">Kontak & Lokasi</h3>
        <ul class="space-y-3.5 text-sm text-slate-600">
          <li class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-sky-500 shrink-0 mt-1" />
            <span class="leading-relaxed">Jl. Bypass Ngurah Rai No. 88, Sanur, Denpasar Selatan, Bali 80228</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-sky-500 shrink-0" />
            <span>+62 812-3456-7890 (WhatsApp)</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-sky-500 shrink-0" />
            <span>halo@baliwandertravel.com</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Developer Branding (Disatukan & Center di Tengah) -->
    <div class="pt-8 border-t border-slate-100 text-center text-sm text-slate-500">
      <p>
        © 2026 BaliWander. Powered by <a href="https://fahrildev.site" target="_blank" rel="noopener noreferrer" class="text-sky-500 hover:text-sky-600 font-semibold transition-colors">FahrilDev</a>.
      </p>
    </div>

  </div>
</footer>
