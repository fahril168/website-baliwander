---
import { Phone, Mail, MapPin, MessageSquare, Camera, Video } from '@lucide/astro';
import { useTranslations, getRouteByLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="bg-white border-t border-slate-200/80 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 3 Kolom Bersih, Lega & Terstruktur -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-14 mb-14">
      
      <!-- Kolom 1 (Kiri - Lebar): Brand & Tentang Kami (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Logo Identik dengan Navbar -->
        <a href={getRouteByLang(lang, 'home')} class="inline-flex items-center gap-1.5 group">
          <span class="text-2xl font-black tracking-tight text-slate-900">
            BaliWander<span class="text-sky-500 font-black">.</span>
          </span>
          <span class="text-xs font-semibold text-slate-400 pl-2 border-l border-slate-200">
            Tour & Travel
          </span>
        </a>

        <p class="text-sm text-slate-600 leading-relaxed max-w-md font-normal">
          {t('footer.about_desc')}
        </p>

        <!-- Ikon Sosial Media -->
        <div class="pt-2 flex items-center gap-2.5 text-slate-500">
          <a 
            href="https://wa.me/6281234567890" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="WhatsApp"
          >
            <MessageSquare class="w-4 h-4" />
          </a>
          <a 
            href="#" 
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="Instagram Galeri Trip"
          >
            <Camera class="w-4 h-4" />
          </a>
          <a 
            href="#" 
            class="w-10 h-10 rounded-full bg-slate-50 hover:bg-sky-50 hover:text-sky-600 border border-slate-200/80 flex items-center justify-center transition-colors" 
            aria-label="TikTok Video Dokumentasi"
          >
            <Video class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Kolom 2 (Tengah): Navigasi Utama Halaman (lg:col-span-3) -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4">
          {t('footer.nav_title')}
        </h3>
        <ul class="space-y-3 text-sm text-slate-600">
          <li>
            <a href={getRouteByLang(lang, 'home')} class="hover:text-sky-600 transition-colors">
              {t('nav.home')}
            </a>
          </li>
          <li>
            <a href={getRouteByLang(lang, 'paket')} class="hover:text-sky-600 transition-colors">
              {t('nav.packages')}
            </a>
          </li>
          <li>
            <a href={getRouteByLang(lang, 'tentang')} class="hover:text-sky-600 transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href={getRouteByLang(lang, 'destinasi')} class="hover:text-sky-600 transition-colors">
              {t('nav.destinations')}
            </a>
          </li>
          <li>
            <a href={getRouteByLang(lang, 'blog')} class="hover:text-sky-600 transition-colors">
              {t('nav.blog')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 3 (Kanan): Kontak & Kantor Resmi (lg:col-span-4) -->
      <div class="lg:col-span-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4">
          {t('footer.contact_title')}
        </h3>
        <ul class="space-y-3.5 text-sm text-slate-600">
          <li class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-sky-500 shrink-0 mt-1" />
            <span class="leading-relaxed">{t('footer.address')}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-sky-500 shrink-0" />
            <span>+62 812-3456-7890 (WhatsApp)</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-sky-500 shrink-0" />
            <span>halo@baliwandertravel.com</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-100 text-center text-sm text-slate-500">
      <p>
        © 2026 BaliWander. {t('footer.rights')} Powered by <a href="https://fahrildev.site" target="_blank" rel="noopener noreferrer" class="text-sky-500 hover:text-sky-600 font-semibold transition-colors">FahrilDev</a>.
      </p>
    </div>

  </div>
</footer>
