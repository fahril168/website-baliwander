---
import { MessageSquare, ArrowRight } from '@lucide/astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative py-16 sm:py-20 overflow-hidden w-full">
  <!-- Background Image Full-Width -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1518548419970-58e3b4079ab2?auto=format&fit=crop&w=2200&q=85" 
      alt="Scenic Bali Ocean Coast" 
      class="w-full h-full object-cover object-center" 
    />
    <!-- Scrim Gelap Transparan -->
    <div class="absolute inset-0 bg-slate-950/70"></div>
  </div>

  <!-- Konten Center Sempurna & Ramping -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center space-y-5">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
      {t('cta.title')}
    </h2>

    <p class="text-base sm:text-lg text-slate-100 leading-relaxed font-normal max-w-2xl mx-auto">
      {t('cta.desc')}
    </p>

    <!-- Tombol WhatsApp CTA -->
    <div class="pt-2 flex justify-center">
      <a 
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(
          lang === 'en'
            ? 'Hello BaliWander, I would like to consult on a custom private itinerary for Bali.'
            : 'Halo BaliWander, saya ingin konsultasi rute custom trip di Bali'
        )}`} 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 sm:py-4 rounded-full bg-sky-500 hover:bg-sky-600 text-white text-base font-bold transition-all active:scale-95 shadow-md shadow-sky-500/15 cursor-pointer whitespace-nowrap"
      >
        <MessageSquare class="w-5 h-5" />
        <span>{t('cta.btn')}</span>
        <ArrowRight class="w-4 h-4 ml-1" />
      </a>
    </div>
  </div>
</section>
