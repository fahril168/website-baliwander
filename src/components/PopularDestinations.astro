---
import { popularDestinationsData } from '../data/tours';
import { ArrowUpRight, MapPin } from '@lucide/astro';
import { useTranslations, getRouteByLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);
const featuredDestinations = popularDestinationsData[lang].slice(0, 3);
---

<section id="destinations" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          {t('destinations.title')}
        </h2>
        <p class="text-base sm:text-lg text-slate-600 mt-2 max-w-xl">
          {t('destinations.subtitle')}
        </p>
      </div>

      <a 
        href={getRouteByLang(lang, 'destinasi')} 
        class="group inline-flex items-center gap-1.5 text-base sm:text-lg font-bold text-sky-600 hover:text-sky-700 transition-colors whitespace-nowrap self-start sm:self-auto py-1"
      >
        <span>{t('destinations.view_all')}</span>
        <ArrowUpRight class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </div>

    <!-- 3 Kolom Kartu Destinasi Besar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredDestinations.map((d) => (
        <a 
          href={`https://wa.me/6281234567890?text=${encodeURIComponent(
            lang === 'en'
              ? `Hello BaliWander, I would like to consult about travel packages to ${d.name}`
              : `Halo BaliWander, mau konsultasi trip ke area ${d.name}`
          )}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-3xl overflow-hidden aspect-[4/5] bg-slate-100 shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-end p-6 sm:p-8"
        >
          <!-- Gambar Background Resolusi Tinggi -->
          <img 
            src={d.image} 
            alt={d.name} 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
          
          <!-- Gradien Scrim Lembut Hanya di Bagian Bawah -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/25 to-transparent"></div>
          
          <!-- Content di Atas Foto -->
          <div class="relative z-10 flex items-end justify-between gap-4">
            <div class="space-y-1">
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-sky-300">
                <MapPin class="w-3.5 h-3.5" />
                <span>{d.tag}</span>
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight group-hover:text-sky-300 transition-colors">
                {d.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-200 font-medium">
                {d.tripsCount} {t('destinations.packages_count')}
              </p>
            </div>

            <!-- Tombol Icon Circle Floating Action -->
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white group-hover:bg-sky-500 group-hover:border-sky-500 group-hover:text-white flex items-center justify-center shrink-0 transition-all duration-300 shadow-lg group-hover:scale-110">
              <ArrowUpRight class="w-5 h-5" />
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
