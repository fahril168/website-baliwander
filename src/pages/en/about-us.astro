---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHeaderBanner from '../../components/PageHeaderBanner.astro';
import Footer from '../../components/Footer.astro';
import { ShieldCheck, HeartHandshake, Sparkles } from '@lucide/astro';
---

<Layout 
  title="About Us | BaliWander Tour & Travel"
  description="Learn more about BaliWander, your certified private tour and chauffeur service provider in Bali dedicated to comfort, honesty, and transparency."
  lang="en"
>
  <Header activePage="tentang" lang="en" />

  <main>
    <!-- Header Banner Full-Width -->
    <PageHeaderBanner 
      title="About BaliWander"
      description="Relaxed, memorable private journeys around Bali with experienced local chauffeurs. Completely free from tourist traps and commission shopping stops."
      image="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=2000&q=85"
    />

    <div class="py-24 bg-white min-h-screen border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
        
        <!-- Intro Section: 2 Columns Editorial -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
              Experience Bali Just Like Traveling with Good Friends.
            </h2>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
              BaliWander was founded by native Balinese drivers and guides who were tired of low-cost tour operators compromising holiday time for shopping commissions.
            </p>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
              We believe holiday moments with family or loved ones are priceless. Our philosophy is simple: treating every guest like welcoming good friends visiting our island for the very first time.
            </p>

            <div class="pt-4 flex items-center gap-6 text-sm text-slate-700 font-semibold">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                <span>100% Licensed Tour Operator</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-sky-500"></span>
                <span>Native English-Speaking Drivers</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-3xl sm:rounded-4xl overflow-hidden shadow-2xl border border-slate-100 h-[460px] bg-slate-100">
              <img 
                src="https://images.unsplash.com/photo-1555400038-63f5ba517a47?auto=format&fit=crop&w=1000&q=80" 
                alt="Balinese Culture & Hospitality" 
                class="w-full h-full object-cover" 
              />
            </div>
          </div>
        </div>

        <!-- 3 Core Service Principles -->
        <div class="pt-16 border-t border-slate-100">
          <div class="max-w-2xl mb-14">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
              Our Core Principles
            </h2>
            <p class="text-base sm:text-lg text-slate-600 mt-2">
              High hospitality standards maintained across our fleet and daily transfer services.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-100 space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-sky-600 flex items-center justify-center shadow-xs">
                <ShieldCheck class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-bold text-slate-900">Transparent Pricing</h3>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                What you pay strictly includes fuel, driver service, entrance tickets, and parking. Zero hidden fees along the way.
              </p>
            </div>

            <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-100 space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-sky-600 flex items-center justify-center shadow-xs">
                <HeartHandshake class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-bold text-slate-900">Completely Flexible Schedules</h3>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                Want an impromptu detour to a famous cafe in Ubud or to adjust departure time for kids? Your driver effortlessly adapts to your pace.
              </p>
            </div>

            <div class="p-8 rounded-3xl bg-slate-50/70 border border-slate-100 space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-sky-600 flex items-center justify-center shadow-xs">
                <Sparkles class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-bold text-slate-900">Vehicle Comfort & Cleanliness</h3>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                Every vehicle (Avanza, Innova Reborn, HiAce Commuter) is rigorously washed, scented, smoke-free, and ice-cold air-conditioned.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>
