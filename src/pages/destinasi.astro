---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeaderBanner from '../components/PageHeaderBanner.astro';
import Footer from '../components/Footer.astro';
import { popularDestinations } from '../data/tours';
import { MapPin, ArrowUpRight } from '@lucide/astro';
---

<Layout 
  title="Kawasan & Destinasi Wisata Bali | BaliWander"
  description="Eksplorasi wilayah wisata terbaik di Bali mulai dari Nusa Penida, Ubud, Uluwatu, Kintamani hingga Kepulauan Gili bersama supir lokal."
>
  <Header activePage="destinasi" />

  <main>
    <!-- Header Banner Gambar Full-Width -->
    <PageHeaderBanner 
      title="Kawasan & Destinasi Favorit"
      description="Setiap sudut Bali memiliki daya tarik yang berbeda: mulai dari tebing laut eksotis di selatan, sejuknya sawah terasering di Ubud, hingga keagungan gunung berapi di Kintamani."
      image="https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&w=2000&q=85"
    />

    <div class="py-24 bg-slate-50/60 min-h-screen border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- 6 Destinasi dalam Grid 3 Kolom Rapi -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {popularDestinations.map((d) => (
            <a 
              href={`https://wa.me/6281234567890?text=Halo%20BaliWander%2C%20mau%20konsultasi%20trip%20ke%20area%20${encodeURIComponent(d.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative rounded-3xl overflow-hidden aspect-[4/5] bg-slate-100 shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 flex flex-col justify-end p-6 sm:p-8"
            >
              <img 
                src={d.image} 
                alt={d.name} 
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/25 to-transparent"></div>
              
              <div class="relative z-10 flex items-end justify-between gap-4">
                <div class="space-y-1">
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-sky-300">
                    <MapPin class="w-3.5 h-3.5" />
                    <span>{d.tag}</span>
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight group-hover:text-sky-300 transition-colors">
                    {d.name}
                  </h2>
                  <p class="text-xs sm:text-sm text-slate-200 font-medium">
                    {d.tripsCount} Pilihan Paket Tour
                  </p>
                </div>

                <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white group-hover:bg-sky-500 group-hover:border-sky-500 flex items-center justify-center shrink-0 transition-all duration-300 shadow-lg group-hover:scale-110">
                  <ArrowUpRight class="w-5 h-5" />
                </div>
              </div>
            </a>
          ))}
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
