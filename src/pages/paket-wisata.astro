---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeaderBanner from '../components/PageHeaderBanner.astro';
import Footer from '../components/Footer.astro';
import { popularPackages, featuredTrips } from '../data/tours';
import { MapPin, Clock, ArrowRight, Check } from '@lucide/astro';

const allTours = [...popularPackages, ...featuredTrips];

function formatRupiah(num: number) {
  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
}
---

<Layout 
  title="Pilihan Paket Wisata Bali & Lombok | BaliWander"
  description="Katalog lengkap paket tour private harian, paket honeymoon, dan liburan keluarga di Bali dengan supir lokal berpengalaman."
>
  <Header activePage="paket" />

  <main>
    <!-- Header Banner Gambar Full-Width -->
    <PageHeaderBanner 
      title="Pilihan Paket Wisata"
      description="Dari private tour harian keliling pantai eksotis hingga paket menginap lengkap dengan villa dan penjemputan bandara. Seluruh rute fleksibel dan bebas kamu sesuaikan."
      image="https://images.unsplash.com/photo-1518548419970-58e3b4079ab2?auto=format&fit=crop&w=2000&q=85"
    />

    <!-- Content Area -->
    <div class="py-24 bg-slate-50/60 min-h-screen border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allTours.map((tour) => (
            <article class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5">
              <div>
                <div class="relative h-64 overflow-hidden bg-slate-100">
                  <img 
                    src={tour.image} 
                    alt={tour.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                  />
                </div>

                <div class="p-6 sm:p-7 space-y-4">
                  <div class="flex items-center justify-between text-xs text-slate-500 font-medium">
                    <span class="inline-flex items-center gap-1.5 text-slate-700 font-semibold">
                      <MapPin class="w-4 h-4 text-sky-500 shrink-0" />
                      <span>{tour.destination}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 text-slate-400">
                      <Clock class="w-3.5 h-3.5" />
                      <span>{tour.duration}</span>
                    </span>
                  </div>

                  <h2 class="text-xl font-bold text-slate-900 leading-snug group-hover:text-sky-600 transition-colors">
                    {tour.title}
                  </h2>

                  <div class="pt-3 border-t border-slate-100 space-y-2">
                    {tour.highlights.slice(0, 3).map((item) => (
                      <div class="flex items-start gap-2 text-xs sm:text-sm text-slate-600">
                        <Check class="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="p-6 sm:p-7 pt-0 border-t border-slate-100 mt-4 flex items-center justify-between">
                <div>
                  <span class="text-xs text-slate-400 font-medium block">Mulai dari</span>
                  <span class="text-xl sm:text-2xl font-extrabold text-slate-900">
                    {formatRupiah(tour.pricePerPax || tour.price)}
                  </span>
                </div>

                <a 
                  href={`https://wa.me/6281234567890?text=Halo%20BaliWander%2C%20saya%20tertarik%20tanya%20detail%20paket%20${encodeURIComponent(tour.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-sky-500 hover:bg-sky-600 text-white text-sm font-bold transition-all active:scale-95 shadow-sm shadow-sky-500/15 whitespace-nowrap cursor-pointer"
                >
                  <span>Pesan</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
