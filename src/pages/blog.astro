---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeaderBanner from '../components/PageHeaderBanner.astro';
import Footer from '../components/Footer.astro';
import { blogPosts } from '../data/tours';
import { ArrowRight } from '@lucide/astro';
---

<Layout 
  title="Blog & Panduan Wisata Bali | BaliWander"
  description="Artikel tips liburan, panduan rute wisata real, dan informasi persiapan liburan ke Bali dan Lombok dari supir lokal terpercaya."
>
  <Header activePage="blog" />

  <main>
    <!-- Header Banner Gambar Full-Width -->
    <PageHeaderBanner 
      title="Catatan & Tips Wisata"
      description="Panduan praktis dan fakta lapangan langsung dari supir serta pemandu lokal kami untuk membantu kamu merencanakan liburan yang nyaman di Bali."
      image="https://images.unsplash.com/photo-1512100356356-de1b84283e18?auto=format&fit=crop&w=2000&q=85"
    />

    <div class="py-24 bg-slate-50/60 min-h-screen border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Articles Grid: 3 Kolom Rapi -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5">
              <div>
                <div class="relative h-60 overflow-hidden bg-slate-100">
                  <img 
                    src={post.image} 
                    alt={post.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                  />
                </div>

                <div class="p-6 sm:p-7 space-y-3">
                  <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
                    <span class="text-sky-600 font-bold">{post.category}</span>
                    <span>•</span>
                    <span>{post.date}</span>
                  </div>

                  <h2 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors leading-snug line-clamp-2">
                    {post.title}
                  </h2>

                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed line-clamp-3">
                    {post.summary}
                  </p>
                </div>
              </div>

              <div class="p-6 sm:p-7 pt-0 border-t border-slate-100 mt-4 flex items-center justify-end">
                <a 
                  href={`https://wa.me/6281234567890?text=Halo%20BaliWander%2C%20saya%20membaca%20artikel%20${encodeURIComponent(post.title)}%20dan%20mau%20tanya`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-600 group-hover:text-sky-700 transition-colors py-1"
                >
                  <span>Baca Panduan</span>
                  <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
